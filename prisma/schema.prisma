// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobApplication {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Job info
  jobSlug         String
  jobTitle        String

  // Personal info
  legalName       String
  passportNo      String
  countryOfOrigin String
  experience      String
  email           String

  // Resume
  resumeUrl       String?
  resumeFileName  String?

  // Client info
  ipAddress       String?
  userAgent       String?
  deviceInfo      Json?     // { deviceType, os, browser }
  ipInfo          Json?     // { city, region, country, countryName, org, timezone, currency, loc }

  // Application status
  status          ApplicationStatus @default(PENDING)
  notes           String?
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEWING
  OFFERED
  REJECTED
  HIRED
}

model ContactSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contact info
  name      String
  email     String
  phone     String?

  // Project details
  budget    String
  message   String   @db.VarChar(10000)

  // Client info
  ipAddress String?
  userAgent String?
  deviceInfo Json?     // { deviceType, os, browser }
  ipInfo     Json?     // { city, region, country, countryName, org, timezone, currency, loc }

  // Status tracking
  status    ContactStatus @default(NEW)
  notes     String?
}

enum ContactStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  PROPOSAL_SENT
  CONVERTED
  CLOSED
}

// Chat KV store — persistent key-value memory for the AI agent
model ChatKVStore {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Chat threads — one per browser token (non-guessable UUID generated client-side)
model ChatThread {
  id         String        @id @default(cuid())
  token      String        @unique  // crypto.randomUUID() from IndexedDB
  ipAddress  String?
  deviceInfo Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]
}

// Individual chat messages linked to a thread
model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String     // "user" | "assistant"
  content   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// Chat leads — visitors who expressed interest via the chatbot
model ChatLead {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  sessionId      String?
  name           String?
  email          String?
  telegramHandle String?
  projectBrief   String?  @db.Text
  budget         String?
  ipAddress      String?
  deviceInfo     Json?
  notified       Boolean  @default(false)
}
